---
// src/components/Promises.astro
---

<section id="promises" class="section" style="background: var(--white);">
  <div class="container">
    <div style="font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.4; margin-bottom: 2rem;">
      WHAT YOU GET
    </div>

    <div style="display: grid; gap: 2rem; max-width: 800px;">
      <div class="reveal" style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 5rem); font-weight: 700; letter-spacing: -0.04em; line-height: 0.9; transition-delay: 0s;">
        ETERNAL<br />PEACE.
      </div>
      <div class="reveal" style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 5rem); font-weight: 700; letter-spacing: -0.04em; line-height: 0.9; transition-delay: 0.15s;">
        NO<br />EXPIRATION.
      </div>
      <div class="reveal" style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 5rem); font-weight: 700; letter-spacing: -0.04em; line-height: 0.9; transition-delay: 0.3s;">
        ONE WAY<br />ENTRY.
      </div>
      <div class="reveal" style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 5rem); font-weight: 700; letter-spacing: -0.04em; line-height: 0.9; transition-delay: 0.45s;">
        LIFETIME<br />ACCESS.
      </div>
    </div>
  </div>
</section>