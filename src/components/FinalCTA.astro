---
// src/components/FinalCTA.astro
---

<section id="final" class="section" style="background: var(--white);">
  <div class="container" style="display: flex; flex-direction: column; justify-content: center; min-height: 70vh; padding: 0 1rem;">
    <div style="font-family: var(--font-display); font-size: clamp(2rem, 6vw, 6rem); font-weight: 700; letter-spacing: -0.04em; line-height: 0.9; max-width: 800px;">
      <span class="reveal">ARE YOU READY</span><br />
      <span class="reveal" style="transition-delay: 0.15s;">TO LEAVE?</span>
    </div>

    <div style="margin-top: 3rem; display: flex; justify-content: flex-start; width: 100%;">
      <a href="#" class="btn-cta reveal" style="transition-delay: 0.3s; text-align: center;">
        <span class="btn-text">GET YOUR TICKET →</span>
        <span class="btn-text-alt">ENTER HEAVEN →</span>
      </a>
    </div>
  </div>
</section>

<style>
@media (max-width: 768px) {
  #final .btn-cta {
    width: 100%;
    text-align: center;
    padding: 0.8rem 1.5rem;
    font-size: 1rem;
  }
}
</style>